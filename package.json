{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-usage",
  "version": "2.0.0",
  "description": "OpenCode TUI plugin that shows the active provider's usage limits (opencode-go 5h/week/month) or remaining credit (deepseek) stacked in the sidebar",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "scripts": {
    "build": "esbuild src/tui.ts --bundle --format=esm --platform=node --external:@opencode/plugin/tui --external:@opentui/solid --external:@opentui/core --external:solid-js --outfile=dist/tui.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-parser.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "limits",
    "quota",
    "opencode-go",
    "deepseek",
    "balance",
    "sidebar",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhw/opencode-plugin-usage.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.11",
    "@opencode/theme": "^2.0.11",
    "@opentui/core": "0.5.11",
    "@opentui/keymap": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.0",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  }
}
