{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-usage",
  "version": "1.0.2",
  "description": "OpenCode TUI plugin that shows the active provider's usage limits (opencode-go 5h/week/month) or remaining credit (deepseek) stacked in the sidebar",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "build": "esbuild src/tui.ts --bundle --format=esm --platform=node --external:@opencode-ai/plugin --external:@opentui/solid --external:@opentui/core --external:solid-js --outfile=dist/tui.js",
    "dev:install": "npm run build && mkdir -p \"$HOME/.config/opencode/usage-limits\" && cp dist/tui.js \"$HOME/.config/opencode/usage-limits/tui.js\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-parser.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "limits",
    "quota",
    "opencode-go",
    "deepseek",
    "balance",
    "sidebar",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhw/opencode-plugin-usage.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@opentui/core": ">=0.2.9",
    "@opentui/solid": ">=0.2.9"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@opentui/core": "0.5.8",
    "@opentui/keymap": "0.5.8",
    "@opentui/solid": "0.5.8",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.0",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2"
  }
}
